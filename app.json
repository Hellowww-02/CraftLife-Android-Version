{
  "expo": {
    "name": "CraftLife",
    "slug": "craftlife",
    "version": "2.0.0",
    "orientation": "portrait",
    "scheme": "craftlife",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "app.craftlife.mobile",
      "versionCode": 200,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#131129"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sharing",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "color": "#8b5cf6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a14"
    }
  }
}
