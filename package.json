{
  "name": "craftlife-android",
  "version": "2.0.0",
  "private": true,
  "description": "CraftLife Android client (M07). Expo + TypeScript, lives OUTSIDE the CraftLife desktop repository on purpose (see README.md). Consumes the compiled @craftlife/core via a file: dependency so domain types, money formatting and the M06 design tokens have exactly one implementation (P2).",
  "main": "expo-router/entry",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@craftlife/core": "file:../CraftLife/packages/craftlife-core",
    "expo": "~57.0.0",
    "expo-background-fetch": "~57.0.21",
    "expo-battery": "~57.0.3",
    "expo-constants": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.12",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.0",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.23",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~57.0.8",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "react-dom": "19.2.3"
  }
}
