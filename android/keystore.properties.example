# Salin file ini menjadi keystore.properties (di folder android/ yang sama),
# isi dengan kredensial upload key kamu, dan JANGAN pernah membagikan /
# meng-commit file aslinya. Buat key-nya sekali saja:
#
#   keytool -genkeypair -v -storetype PKCS12 -keystore craftlife-upload.keystore \
#     -alias craftlife-upload -keyalg RSA -keysize 2048 -validity 10000
#
# Simpan keystore + kata sandi di pengelola kata sandi. Hilang = tidak bisa
# update aplikasi di Play Store tanpa proses reset upload key ke Google.
storeFile=craftlife-upload.keystore
storePassword=GANTI_DENGAN_PASSWORD_STORE
keyAlias=craftlife-upload
keyPassword=GANTI_DENGAN_PASSWORD_KEY
